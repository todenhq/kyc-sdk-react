{
  "name": "@myazahq/kyc-sdk-react",
  "version": "3.6.0",
  "description": "Myaza KYC SDK for React — drop-in identity verification: ID capture, document scan, and active liveness detection",
  "license": "MIT",
  "author": "Flitstack Technologies Inc.",
  "keywords": [
    "kyc",
    "kyb",
    "identity-verification",
    "id-verification",
    "document-verification",
    "liveness",
    "liveness-detection",
    "face-detection",
    "biometrics",
    "aml",
    "onboarding",
    "react",
    "myaza"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/myazahq/kyc-sdk-react.git"
  },
  "homepage": "https://github.com/myazahq/kyc-sdk-react#readme",
  "bugs": {
    "url": "https://github.com/myazahq/kyc-sdk-react/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./texts": {
      "types": "./dist/texts.d.ts",
      "import": "./dist/texts.mjs",
      "require": "./dist/texts.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "gifs"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build:css": "tailwindcss -i ./src/globals.css -o ./src/generated/styles.css.txt --minify",
    "build": "pnpm build:css && tsup",
    "dev": "pnpm build:css && (tsup --watch & tailwindcss -i ./src/globals.css -o ./src/generated/styles.css.txt --minify --watch)",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "4.2.3",
    "@hugeicons/react": "1.1.9",
    "@mediapipe/camera_utils": "^0.3.1675466862",
    "@mediapipe/face_mesh": "^0.4.1633559619",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-focus-scope": "1.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.18",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "country-flag-icons": "^1.6.17",
    "input-otp": "^1.4.2",
    "libphonenumber-js": "^1.13.8",
    "react-day-picker": "^10.0.1",
    "react-remove-scroll": "^2.7.2",
    "tailwind-merge": "^3.5.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.1",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "next": "^16.2.1",
    "postcss": "^8.5.8",
    "qrcode-generator": "^2.0.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwindcss": "^4.2.2",
    "tailwindcss-animate": "^1.0.7",
    "tsup": "^8.5.1",
    "typescript": "^6.0.2",
    "vitest": "^4.1.9"
  }
}
